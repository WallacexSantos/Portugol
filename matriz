programa {  
  /*4. Faça um programa que declare uma matriz 50 x
50 com valores inteiros. O programa deve
oferecer um menu com as opções:
a) Permitir ao usuário dizer com quais dimensões ele
quer trabalhar (n x m), desde que não ultrapasse o
tamanho máximo declarado.
c)Calcule a média de todos os elementos da matriz.
b) Leia os dados para preencher a matriz.
d) Imprima a quantidade de elementos pares e a
quantidade de elementos ímpares que estão acima
da média.*/
  inclua biblioteca Util --> u
  funcao matriz() {
  
  inteiro  matriz[50][50],i=1,linhas,colunas,opcao,x,y
  caracter ENTER
 escreva("\nPREENCHA A MATRIZ")
 escreva("\nDigite a quantidade de linhas da matriz(max 50 linhas):")
 leia(x)
 escreva("\nDigite a quantidade de colunas da matriz(max 50 colunas):")
 leia(y)
 escreva("\nDigite [1] para preencher manualmente a matriz")
 escreva("\nDigite [2] para  a matriz ser preenchida aleatoriamente\n")
 leia(opcao)
  enquanto(opcao<1 ou opcao<2){
  escreva("\nopcao invalida")
  escreva("\nDigite [1] para preencher manualmente a matriz")
  escreva("\nDigite [2] para  a matriz ser preenchida aleatoriamente\n")
  }
 escolha (opcao){
  caso 1:
   para (linhas=0;linhas<x;linhas++){
      	para(colunas=0;colunas<y;colunas++){
          escreva("\nDigite o valor da linha ",linhas," e da coluna ",colunas,": ")
      		leia(matriz[linhas][colunas])
      	}
      }
      escreva("\nA matriz preenchida foi:\n")
      para (linhas=0;linhas<x;linhas++){
      	para(colunas=0;colunas<y;colunas++){
      		escreva(matriz[linhas][colunas],"  ")
      	}
        escreva("\n")
      }
      escreva("\nAperte Enter para abrir o menu: ")
      leia(ENTER)
  pare

  caso 2:
   para (linhas=0;linhas<x;linhas++){
      	para(colunas=0;colunas<y;colunas++){
      		matriz[linhas][colunas]=u.sorteia(1,10)
      	}
      }
      escreva("\nA matriz preenchida foi:\n")
      para (linhas=0;linhas<x;linhas++){
      	para(colunas=0;colunas<y;colunas++){
      		escreva(matriz[linhas][colunas],"  ")
      	}
        escreva("\n")
      }
      escreva("\nAperte Enter para abrir o menu: ")
      leia(ENTER)
  pare
 }
}
  funcao inicio() {
  
 inteiro opcao=1,menu=0
 cadeia matriz_preenchida

 se(matriz_preenchida != "sim"){
  matriz_preenchida = "sim"
  matriz()
 }
 enquanto(menu==0){

  escreva("\nDigite [1] para preencher a matriz novamente")
  escreva("\nDigite [2] para ver a media dos valores da matriz")
  escreva("\nDigite [3] para ver a quantidade de elementos pares e a quantidade de elementos ímpares que estão acima da média")
  escreva("\nDigite [4] para fechar o programa")
  leia(opcao)
  escolha(opcao){
   caso 1:
   matriz()
   pare

   caso 2:

   pare

   caso 3:

   pare

   caso 4:
   menu++
   pare
    }
   }
  }
}
