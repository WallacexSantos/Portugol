programa {
  funcao inicio() {
    /*Leia 15 números entre 1 e 10 (valores fora desse intervalo não devem ser
armazenados e o valor de entrada deve ser pedido novamente até que esteja
nesse intervalo). Ao final, mostre quantas vezes cada número apareceu*/
  inteiro numero[10],i,numeros[i]
  para (i=0;i<15;i++){
  escreva ("digite um numero de 1 ate 10: ")
  leia (numero[i])
  numeros[i]++
  enquanto (numero[i]>10 ou numero[i]<1){
  escreva ("valor incorreto, digite um numero de 1 ate 10: ")
  leia (numero[i])
  numeros[i]++
 }
   }
   para (i=1;i<11;i++)
   escreva ("\no numero ",i," apareceu ",numeros[i]," vezes" )
  }
}
